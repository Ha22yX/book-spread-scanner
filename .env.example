# Copy to .dev.vars. Never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Local background queue secret; use a long random value, never expose in the browser.
PROCESSOR_TOKEN=
# For a private Sites-hosted web app with a desktop OCR processor:
PROCESSOR_BASE_URL=http://127.0.0.1:3000
SITE_ACCESS_TOKEN=
